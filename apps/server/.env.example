# Copy to apps/server/.env (gitignored).
DATABASE_URL=postgres://localhost:5432/landed_dev
# 32 random bytes, base64:  openssl rand -base64 32
SECRETS_KEY=
HOST=127.0.0.1
PORT=8787
# true in production (browser reaches us over https via Cloudflare Tunnel)
COOKIE_SECURE=false
# first-only: sign-up allowed only while there are no users. open: anyone.
SIGNUP=first-only
# Built web app to serve at /. Default: ../web/dist. Set empty to disable.
# WEB_DIST=
# Public origin for cloud agents' OAuth/MCP metadata (e.g. https://landed.example.com).
# Unset: taken from each request's Host / X-Forwarded-* headers.
# PUBLIC_URL=
