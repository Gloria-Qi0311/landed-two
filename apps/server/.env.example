# Copy to apps/server/.env (gitignored).
DATABASE_URL=postgres://localhost:5432/landed_dev
# 32 random bytes, base64:  openssl rand -base64 32
SECRETS_KEY=
HOST=127.0.0.1
PORT=8787
# true in production (browser reaches us over https via Cloudflare Tunnel)
COOKIE_SECURE=false
# first-only: sign-up allowed only while there are no users. open: anyone.
SIGNUP=first-only
# Built web app to serve at /. Default: ../web/dist. Set empty to disable.
# WEB_DIST=
# Public origin for cloud agents' OAuth/MCP metadata (e.g. https://landed.example.com).
# Unset: taken from each request's Host / X-Forwarded-* headers.
# PUBLIC_URL=
# Password-reset email. Standard SMTP is the portable default: point it at
# your own relay or any provider. Leave EMAIL_TRANSPORT unset to disable email
# recovery; offline single-use recovery codes remain available in the app.
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=no-reply@example.com
# EMAIL_FROM_NAME=Landed
#
# Optional Cloudflare Email Sending transport instead of SMTP:
# EMAIL_TRANSPORT=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
# EMAIL_FROM=no-reply@example.com
# EMAIL_FROM_NAME=Landed
