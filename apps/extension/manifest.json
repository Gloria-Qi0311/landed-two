{
  "manifest_version": 3,
  "name": "Landed",
  "version": "2.8",
  "key": "",
  "description": "Landed: job-hunt operations — auto-fill applications + portal sync. (Renamed from ApplyMint after merge in Sprint 3.)",
  "permissions": ["activeTab", "tabs", "storage", "unlimitedStorage", "scripting", "sidePanel", "alarms", "nativeMessaging"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["schema.js", "lib/field-detect.js", "lib/value-match.js", "lib/cross-lingual.js", "lib/llm-providers.js", "lib/llm-match.js", "lib/portal-parsers/greenhouse.js", "lib/portal-parsers/lever.js", "lib/portal-parsers/workday.js", "lib/portal-parsers/ashby.js", "lib/choice-answers.js", "lib/fill/core.js", "lib/fill/blockers.js", "lib/fill/selects.js", "lib/fill/values.js", "lib/fill/combobox.js", "lib/fill/files.js", "lib/fill/choices.js", "lib/fill/inputs.js", "lib/fill/dates.js", "lib/fill/experience.js", "lib/fill/ai.js", "lib/fill/review.js", "lib/fill/open-answers.js", "lib/fill/learn.js", "lib/fill/unanswered.js", "lib/fill/frames.js", "lib/fill/portal.js", "lib/fill/submit.js", "lib/fill/trace.js", "lib/fill/settle.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://mcn.tail109da9.ts.net/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["lib/web-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
