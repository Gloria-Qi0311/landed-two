# Public vars — exposed to the browser bundle (Vite inlines these at build time).
# Copy this file to `.env.local` (gitignored) and fill in your project's values.
# Get them from: https://supabase.com/dashboard/project/<your-ref>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only — no VITE_ prefix means Vite never inlines this into the browser
# bundle. Used by the dev-only /api/dev/login middleware in vite.config.ts so
# you can one-click sign in during dev without bouncing through email.
# DEV CONVENIENCE ONLY. Never reference this from src/.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
