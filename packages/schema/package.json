{
  "name": "@landed/schema",
  "private": true,
  "version": "0.0.0",
  "description": "Shared schemas: canonical resume (TS types + zod validators) and the job search brief. Consumed by apps/web, apps/extension and apps/server.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./search-brief": "./src/search-brief.ts",
    "./email-check": "./src/email-check.ts",
    "./portal-check": "./src/portal-check.ts",
    "./pipeline": "./src/pipeline.ts",
    "./master-resume": "./src/master-resume.ts",
    "./conversation": "./src/conversation.ts",
    "./automation": "./src/automation.ts",
    "./cloud-agent": "./src/cloud-agent.ts",
    "./reported-application": "./src/reported-application.ts",
    "./application-answers": "./src/application-answers.ts",
    "./application-files": "./src/application-files.ts"
  },
  "scripts": {
    "build": "echo 'no build \u2014 consumed as source via workspace alias'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
